# Copy to .env.local and fill in locally. Never commit .env.local.
# Key is supplied separately by your Unissant point of contact.
CHALLENGEX_API_KEY=replace-with-your-key
CHALLENGEX_BASE_URL=https://challengex-ext2.unissantmissionworks.com/v1
CHALLENGEX_MODEL=gpt-oss-20b
# Per-request timeout in milliseconds and retry count for the shared endpoint
CHALLENGEX_TIMEOUT_MS=55000
CHALLENGEX_MAX_RETRIES=1

# ---- Public demo only (hosting-free-1; see eval/ui-mobile-1/HOSTING-PLAN-FREE.md). Not needed for the local tool.
# On Vercel these are set as Secret environment variables for Production; never commit real values.
# Storage: one Upstash Redis database on the Free plan (REST URL and token from the Upstash console).
UPSTASH_REDIS_REST_URL=replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# At least 32 random characters (signs visitor and judge cookies).
NC_VISITOR_SECRET=replace-with-32-plus-random-characters
# At least 16 characters; shared with judges privately. Live reviews and PDF uploads need it.
NC_JUDGE_CODE=replace-with-16-plus-character-code
# Optional limits (defaults shown): live reviews per judge session per hour, per IP per day, per day, in total,
# and running at once; saved-data retention in days after the last change.
# NC_RL_JUDGE_PER_HOUR=15
# NC_RL_IP_PER_DAY=30
# NC_CAP_PER_DAY=60
# NC_CAP_TOTAL=400
# NC_MAX_INFLIGHT=3
# NC_RETENTION_DAYS=30
# Rehearse the public demo locally (not on Vercel): NC_PUBLIC_DEMO=1
