# Copy to .env.local and fill in locally. Never commit .env.local.
# Key is supplied separately by your Unissant point of contact.
CHALLENGEX_API_KEY=replace-with-your-key
CHALLENGEX_BASE_URL=https://challengex-ext2.unissantmissionworks.com/v1
CHALLENGEX_MODEL=gpt-oss-20b
# Per-request timeout in milliseconds and retry count for the shared endpoint
CHALLENGEX_TIMEOUT_MS=55000
CHALLENGEX_MAX_RETRIES=1
